generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model advisor {
  s_id       String      @id @db.VarChar(5)
  i_id       String?     @db.VarChar(5)
  instructor instructor? @relation(fields: [i_id], references: [id], onUpdate: NoAction)
  student    student     @relation(fields: [s_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model classroom {
  building    String    @db.VarChar(15)
  room_number String    @db.VarChar(7)
  capacity    Decimal?  @db.Decimal(4, 0)
  section     section[]

  @@id([building, room_number])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model course {
  course_id                       String      @id @db.VarChar(8)
  title                           String?     @db.VarChar(50)
  dept_name                       String?     @db.VarChar(20)
  credits                         Decimal?    @db.Decimal(2, 0)
  department                      department? @relation(fields: [dept_name], references: [dept_name], onUpdate: NoAction)
  prereq_prereq_course_idTocourse prereq[]    @relation("prereq_course_idTocourse")
  prereq_prereq_prereq_idTocourse prereq[]    @relation("prereq_prereq_idTocourse")
  section                         section[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model department {
  dept_name  String       @id @db.VarChar(20)
  building   String?      @db.VarChar(15)
  budget     Decimal?     @db.Decimal(12, 2)
  course     course[]
  instructor instructor[]
  student    student[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model instructor {
  id         String      @id @db.VarChar(5)
  name       String      @db.VarChar(20)
  dept_name  String?     @db.VarChar(20)
  salary     Decimal?    @db.Decimal(8, 2)
  advisor    advisor[]
  department department? @relation(fields: [dept_name], references: [dept_name], onUpdate: NoAction)
  teaches    teaches[]
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model player {
  a Int?
  b Int?

  @@index([a], map: "indexa")
  @@ignore
}

model prereq {
  course_id                       String @db.VarChar(8)
  prereq_id                       String @db.VarChar(8)
  course_prereq_course_idTocourse course @relation("prereq_course_idTocourse", fields: [course_id], references: [course_id], onDelete: Cascade, onUpdate: NoAction)
  course_prereq_prereq_idTocourse course @relation("prereq_prereq_idTocourse", fields: [prereq_id], references: [course_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([course_id, prereq_id])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model r {
  Column_Name           Unsupported("name")? @map("Column Name")
  Primary_Key           String?              @map("Primary Key")
  Nullable              String?              @db.VarChar(3)
  Foreign_Key_Reference String?              @map("Foreign Key Reference")
  Data_Type             String?              @map("Data Type") @db.VarChar
  Length                Int?

  @@ignore
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model section {
  course_id    String     @db.VarChar(8)
  sec_id       String     @db.VarChar(8)
  semester     String     @db.VarChar(6)
  year         Decimal    @db.Decimal(4, 0)
  building     String?    @db.VarChar(15)
  room_number  String?    @db.VarChar(7)
  time_slot_id String?    @db.VarChar(4)
  classroom    classroom? @relation(fields: [building, room_number], references: [building, room_number], onUpdate: NoAction)
  course       course     @relation(fields: [course_id], references: [course_id], onDelete: Cascade, onUpdate: NoAction)
  takes        takes[]
  teaches      teaches[]

  @@id([course_id, sec_id, semester, year])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model student {
  id         String      @id @db.VarChar(5)
  name       String      @db.VarChar(20)
  dept_name  String?     @db.VarChar(20)
  tot_cred   Decimal?    @db.Decimal(3, 0)
  advisor    advisor?
  department department? @relation(fields: [dept_name], references: [dept_name], onUpdate: NoAction)
  takes      takes[]
}

model student_grades {
  id  String   @id @db.VarChar(5)
  gpa Decimal? @db.Decimal(2, 0)
}

model takes {
  id        String  @db.VarChar(5)
  course_id String  @db.VarChar(8)
  sec_id    String  @db.VarChar(8)
  semester  String  @db.VarChar(6)
  year      Decimal @db.Decimal(4, 0)
  grade     String? @db.VarChar(2)
  section   section @relation(fields: [course_id, sec_id, semester, year], references: [course_id, sec_id, semester, year], onDelete: Cascade, onUpdate: NoAction)
  student   student @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([id, course_id, sec_id, semester, year])
}

model takes2 {
  id        String  @db.VarChar(5)
  course_id String  @db.VarChar(8)
  sec_id    String  @db.VarChar(8)
  semester  String  @db.VarChar(6)
  year      Decimal @db.Decimal(4, 0)
  grade     String? @db.VarChar(2)

  @@id([id, course_id, sec_id, semester, year])
}

model teaches {
  id         String     @db.VarChar(5)
  course_id  String     @db.VarChar(8)
  sec_id     String     @db.VarChar(8)
  semester   String     @db.VarChar(6)
  year       Decimal    @db.Decimal(4, 0)
  section    section    @relation(fields: [course_id, sec_id, semester, year], references: [course_id, sec_id, semester, year], onDelete: Cascade, onUpdate: NoAction)
  instructor instructor @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([id, course_id, sec_id, semester, year])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model time_slot {
  time_slot_id String   @db.VarChar(4)
  day          String   @db.VarChar(1)
  start_hr     Decimal  @db.Decimal(2, 0)
  start_min    Decimal  @db.Decimal(2, 0)
  end_hr       Decimal? @db.Decimal(2, 0)
  end_min      Decimal? @db.Decimal(2, 0)

  @@id([time_slot_id, day, start_hr, start_min])
}
